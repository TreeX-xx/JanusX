{
  "name": "@janusx/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "JanusX local plugin contract, validation and scaffold",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "janusx-plugin": "./tools/cli.mjs" },
