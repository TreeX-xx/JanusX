{
  "schemaVersion": 1,
  "id": "example.status-consumer",
  "name": "Public status task",
  "version": "1.0.0",
  "engines": { "pluginApi": "^1.0.0" },
  "capabilities": { "required": ["tasks.declarative", "services.public"], "optional": [] },
  "permissions": [{ "name": "tasks.run" }, { "name": "services.public" }],
  "contributes": {
    "views": [],
    "tasks": [{ "id": "status", "title": "Read GitHub public status", "scope": "application", "input": {}, "timeoutMs": 6000,
